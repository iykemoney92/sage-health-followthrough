ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Post-call webhook signing secret (ElevenLabs dashboard -> Conversational AI -> Webhooks)
ELEVENLABS_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTH_HEADER=
REVENUECAT_PLUS_PRODUCT_IDS=prod_UxrFQntebp8P6e,prod48328e2cc1,price_1TxvWrLRJZHcAjIaS9VlfzTM
REVENUECAT_WEB_PURCHASE_URL=
REVENUECAT_SANDBOX_WEB_PURCHASE_URL=https://pay.rev.cat/sandbox/zxhobyxujoduesql/
REVENUECAT_BILLING_MODE=
REVENUECAT_REST_API_KEY=
REVENUECAT_PUBLIC_API_KEY=
# Native in-app purchase (App Store Guideline 3.1.1). Public SDK keys from the
# RevenueCat dashboard, per platform — the strp_ key above is web billing only.
# Leave unset and the native app shows "subscriptions unavailable" rather than
# falling back to web checkout, which Apple forbids inside the app.
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_PLUS_PRICE_ID=
# Optional: Stripe Customer Portal login page URL from Stripe Dashboard → Settings → Billing → Customer portal
STRIPE_CUSTOMER_PORTAL_LOGIN_URL=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
SUPPORT_EMAIL=support@usenura.app
RESEND_API_KEY=
AUTH_EMAIL_FROM=Nura <hello@usenura.app>
# Production must be https://usenura.app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google Analytics (gtag) — loaded only after cookie consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SQE591XWW3
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@usenura.app
LOG_LEVEL=info

# Store listing for the "update available" prompt; defaults to the real ID in code.
NEXT_PUBLIC_IOS_APP_STORE_URL=
# Oldest native build that still works against this deployment. Bump only when
# the web app starts needing something an older binary cannot do.
NURA_MIN_NATIVE_BUILD=1
