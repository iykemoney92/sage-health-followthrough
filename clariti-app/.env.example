NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ELEVENLABS_API_KEY=
CLARITI_ELEVENLABS_API_KEY=
CLARITI_ELEVENLABS_AGENT_ID=
CLARITI_ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Backwards-compatible fallback only. Prefer the CLARITI_* variables above.
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
AGENT_TOOL_SECRET=
CRON_SECRET=
CLARITI_VIDEO_MODEL=google/veo-3.1-generate-001
CLARITI_VIDEO_PIPELINE=shotstack
# Shotstack is OPTIONAL. Leave both empty and Clariti renders one presenter clip
# per explainer, which needs nothing but Veo. Set a key and Clariti designs a
# five-scene storyboard, renders the scenes in parallel, and stitches them —
# five times the Veo spend per video, so only do it with a key that works.
#
# The key is verified with one request before each job is planned; a key that
# Shotstack rejects falls back to the single clip rather than paying for five
# scenes it cannot join. Deliberately unset in production as of 2026-09-09: the
# key that was there had been revoked (403 from both Shotstack environments).
#
# Base URL: production is /edit/v1 and sandbox is /edit/stage. They take
# different keys — a sandbox key gets 403 from /edit/v1 and vice versa — and
# sandbox output is watermarked. The value is trimmed, so a stray newline no
# longer breaks the path. Set CLARITI_VIDEO_PIPELINE=single to force one clip
# even when a valid key is present.
SHOTSTACK_API_KEY=
SHOTSTACK_BASE_URL=https://api.shotstack.io/edit/v1

# --- Clariti Plus billing (RevenueCat) ---
# "sandbox" or "live". Defaults to "live" when VERCEL_ENV/NODE_ENV is production, else "sandbox".
CLARITI_REVENUECAT_BILLING_MODE=
# Public Web Billing SDK keys (safe to expose client-side). Reserved for a future
# @revenuecat/purchases-js integration — not required for the current redirect-based checkout.
NEXT_PUBLIC_CLARITI_REVENUECAT_SANDBOX_WEB_BILLING_KEY=
NEXT_PUBLIC_CLARITI_REVENUECAT_WEB_BILLING_KEY=
# Hosted RevenueCat "Web Purchase Link" (pay.rev.cat/...) used by /api/billing/checkout.
# The signed-in user's id is appended as the RC app_user_id.
#
# DELIBERATELY UNSET IN PRODUCTION. pay.rev.cat serves its own SPA shell instead
# of JSON for every /v1/* route — including /v1/health and a made-up link id —
# so the checkout page reads its config, fails to parse it, and never asks for
# products. Sandbox and production links both hang. With this empty,
# /api/billing/checkout falls through to Stripe Checkout, which carries the same
# 7-day trial. Set it again once RevenueCat's portal serves JSON.
CLARITI_REVENUECAT_SANDBOX_WEB_PURCHASE_URL=https://pay.rev.cat/sandbox/mdknmcezqkniaxti/
CLARITI_REVENUECAT_WEB_PURCHASE_URL=
# Secret REST API key (per-project) for server-side subscriber lookups in lib/billing/sync-plus.ts.
CLARITI_REVENUECAT_REST_API_KEY=
# Shared secret RevenueCat sends as the Authorization header on webhook requests.
CLARITI_REVENUECAT_WEBHOOK_AUTH_HEADER=
# Comma-separated Plus product ids across every store (defaults are already set in code).
# Must include the App Store / Play ids clariti_plus_monthly and clariti_plus_annual.
CLARITI_REVENUECAT_PLUS_PRODUCT_IDS=

# --- Native in-app purchase (iOS / Android) ---
# Public RevenueCat SDK keys, one per platform. Safe to expose client-side — they
# can only read offerings and make purchases for the signed-in app user. Without
# them the app falls back to reporting purchases as unavailable rather than
# opening a web checkout, which App Store Guideline 3.1.1 forbids in-app.
# RevenueCat → Project → API keys → App-specific "public" key (appl_… / goog_…).
NEXT_PUBLIC_CLARITI_REVENUECAT_IOS_API_KEY=
NEXT_PUBLIC_CLARITI_REVENUECAT_ANDROID_API_KEY=

# --- Stripe emergency fallback only (unused when RevenueCat purchase URL is set) ---
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_PLUS_PRICE_ID=

# Absolute public app URL (no trailing slash). Used for auth confirmation emails and
# billing redirects. Production: https://useclariti.app
# If unset, Clariti falls back to the request origin, then VERCEL_URL.
NEXT_PUBLIC_APP_URL=https://useclariti.app

# Clariti-branded auth emails (Resend). From display name should be "Clariti".
# Use a verified Resend domain (currently hello@usenura.app) until useclariti.app is verified.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Clariti <hello@usenura.app>

# --- Native shell ---
# App Store listing for app.useclariti.mobile, used by the "update available"
# notice. Leave EMPTY until the app is live: an unset value renders the notice
# without a link, while a wrong id sends people to a "not available" page.
NEXT_PUBLIC_IOS_APP_STORE_URL=
# Oldest native build number that still works against this deployment. Raise it
# only when the web app starts depending on something an older binary genuinely
# cannot do (a new Capacitor plugin, a changed URL scheme). Web-only changes
# never need it.
CLARITI_MIN_NATIVE_BUILD=1

# --- Scheduled follow-ups ---
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. The trigger route fails
# closed when neither this nor AGENT_TOOL_SECRET is set.
CRON_SECRET=

# Comma-separated OAuth providers that are actually enabled in the Supabase
# dashboard — e.g. "apple,google". Empty (the default) hides the buttons
# entirely, because a provider Supabase does not know about returns a 400 the
# moment someone taps it. App Store Guideline 4.8 means "google" must not be
# listed without "apple".
NEXT_PUBLIC_CLARITI_OAUTH_PROVIDERS=
