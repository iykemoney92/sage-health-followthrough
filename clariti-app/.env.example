NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ELEVENLABS_API_KEY=
CLARITI_ELEVENLABS_API_KEY=
CLARITI_ELEVENLABS_AGENT_ID=
CLARITI_ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Backwards-compatible fallback only. Prefer the CLARITI_* variables above.
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
AGENT_TOOL_SECRET=
CRON_SECRET=
# --- Explainer video ---
# FLUX 3 through the Vercel AI Gateway. It renders 5 to 20 seconds with audio in a
# single call, which is why the explainer no longer needs stitching at all: the
# five-scene cut existed only to get past Veo's 8-second ceiling.
CLARITI_VIDEO_MODEL=bfl/flux-3-video
# How the explainer is put together.
#   single   — one Flux call, up to 20 seconds. The default on Flux, and the cheapest.
#   chained  — for explainers longer than one clip. Each segment after the first is
#              handed the previous mp4 so the model carries on from its last frames.
#   shotstack — legacy. Renders a five-scene storyboard on a Veo model and stitches it
#              with Shotstack. Only engages when this is set to "shotstack", a Veo model
#              is configured, and the Shotstack key is one Shotstack currently accepts.
#              Flux never routes here.
CLARITI_VIDEO_PIPELINE=single
# Output size: "hd" (1280x720, the default) or "fhd" (1920x1080). Larger costs more per
# second, so leave it on hd unless a clip is going somewhere that needs the detail.
CLARITI_VIDEO_RESOLUTION=hd
#
# Cost, for choosing between them: Veo is $0.40/sec at 720p with audio, so the old
# five-scene cut spent that five times over plus a Shotstack render. Flux text-to-video
# is around $0.17/sec, and the video-to-video call that chaining uses is around
# $0.41/sec — roughly 2.4x a fresh clip. One 20-second Flux clip is therefore both the
# cheapest explainer and the one with the fewest moving parts, which is why it is the
# default.
#
# Shotstack is OPTIONAL and no longer the default. Leaving both values empty is the
# normal state. The key is verified with one request before a job is planned; a key
# Shotstack rejects falls back rather than paying for scenes it cannot join.
# Deliberately unset in production as of 2026-09-09: the key that was there had been
# revoked (403 from both Shotstack environments).
#
# Base URL: production is /edit/v1 and sandbox is /edit/stage. They take different keys
# — a sandbox key gets 403 from /edit/v1 and vice versa — and sandbox output is
# watermarked. The value is trimmed, so a stray newline no longer breaks the path.
SHOTSTACK_API_KEY=
SHOTSTACK_BASE_URL=https://api.shotstack.io/edit/v1

# --- Clariti Plus billing (RevenueCat) ---
# "sandbox" or "live". Defaults to "live" when VERCEL_ENV/NODE_ENV is production, else "sandbox".
CLARITI_REVENUECAT_BILLING_MODE=
# Public Web Billing SDK keys (safe to expose client-side). Reserved for a future
# @revenuecat/purchases-js integration — not required for the current redirect-based checkout.
NEXT_PUBLIC_CLARITI_REVENUECAT_SANDBOX_WEB_BILLING_KEY=
NEXT_PUBLIC_CLARITI_REVENUECAT_WEB_BILLING_KEY=
# Hosted RevenueCat "Web Purchase Link" (pay.rev.cat/...) used by /api/billing/checkout.
# The signed-in user's id is appended as the RC app_user_id.
#
# DELIBERATELY UNSET IN PRODUCTION. pay.rev.cat serves its own SPA shell instead
# of JSON for every /v1/* route — including /v1/health and a made-up link id —
# so the checkout page reads its config, fails to parse it, and never asks for
# products. Sandbox and production links both hang. With this empty,
# /api/billing/checkout only falls through to Stripe Checkout when
# STRIPE_WEBHOOK_SECRET is set too; without it the route refuses and the web
# paywall says Plus cannot be bought on the web, because a Stripe trial nothing
# renews expires into /billing/locked while the card keeps being charged.
# Set it again once RevenueCat's portal serves JSON.
CLARITI_REVENUECAT_SANDBOX_WEB_PURCHASE_URL=https://pay.rev.cat/sandbox/mdknmcezqkniaxti/
CLARITI_REVENUECAT_WEB_PURCHASE_URL=
# Secret REST API key (per-project) for server-side subscriber lookups in lib/billing/sync-plus.ts.
CLARITI_REVENUECAT_REST_API_KEY=
# Shared secret RevenueCat sends as the Authorization header on webhook requests.
CLARITI_REVENUECAT_WEBHOOK_AUTH_HEADER=
# Comma-separated Plus product ids across every store (defaults are already set in code).
# Must include the App Store / Play ids clariti_plus_monthly and clariti_plus_annual.
CLARITI_REVENUECAT_PLUS_PRODUCT_IDS=

# --- Native in-app purchase (iOS / Android) ---
# Public RevenueCat SDK keys, one per platform. Safe to expose client-side — they
# can only read offerings and make purchases for the signed-in app user. Without
# them the app falls back to reporting purchases as unavailable rather than
# opening a web checkout, which App Store Guideline 3.1.1 forbids in-app.
# RevenueCat → Project → API keys → App-specific "public" key (appl_… / goog_…).
NEXT_PUBLIC_CLARITI_REVENUECAT_IOS_API_KEY=
NEXT_PUBLIC_CLARITI_REVENUECAT_ANDROID_API_KEY=

# --- Stripe emergency fallback only (unused when RevenueCat purchase URL is set) ---
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_PLUS_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Absolute public app URL (no trailing slash). Used for auth confirmation emails and
# billing redirects. Production: https://useclariti.app
# If unset, Clariti falls back to the request origin, then VERCEL_URL.
NEXT_PUBLIC_APP_URL=https://useclariti.app

# Clariti-branded auth emails (Resend). From display name should be "Clariti".
# Use a verified Resend domain (currently hello@usenura.app) until useclariti.app is verified.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Clariti <hello@usenura.app>
SUPPORT_EMAIL=

# --- Native shell ---
# Store listings for app.useclariti.mobile. Each one gates its own download
# button on the landing page: the App Store button appears only when the iOS URL
# is set, the Google Play button only when the Android URL is, and with neither
# set the whole block renders nothing. The iOS value also supplies the link in
# the "update available" notice.
#
# Leave a store EMPTY until the app is genuinely downloadable there. A wrong or
# premature id sends people to a "not available" page, and a dead button is
# worse than no button.
#
# Both stores are live now: iOS went on sale in all 175 territories on
# 2026-09-15, and Google Play earlier. Note the ordering these variables demand
# — NEXT_PUBLIC_* is inlined at build time, so a store URL has to exist in the
# environment BEFORE the deploy that should show its button. Setting it after a
# build leaves the button missing until something else triggers a rebuild, and
# this project has an Ignored Build Step that skips builds when nothing under
# clariti-app/ changed.
NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/id6806667378
NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.useclariti.mobile
# Oldest native build number that still works against this deployment. Raise it
# only when the web app starts depending on something an older binary genuinely
# cannot do (a new Capacitor plugin, a changed URL scheme). Web-only changes
# never need it.
CLARITI_MIN_NATIVE_BUILD=1

# --- Scheduled follow-ups ---
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. The trigger route fails
# closed when neither this nor AGENT_TOOL_SECRET is set.
CRON_SECRET=

# Comma-separated OAuth providers that are actually enabled in the Supabase
# dashboard — e.g. "apple,google". Empty (the default) hides the buttons
# entirely, because a provider Supabase does not know about returns a 400 the
# moment someone taps it. App Store Guideline 4.8 means "google" must not be
# listed without "apple".
NEXT_PUBLIC_CLARITI_OAUTH_PROVIDERS=

# Sign in with Apple token revocation on account deletion — guideline 5.1.1(v)
# obliges it, and app id 6806667378 has already been cited for it. Read by
# lib/auth/apple-revoke.ts, which takes the CLARITI_ prefix and nothing else: an
# unprefixed APPLE_* is read by no code here, so the revoke reports
# missing_apple_config and silently never fires.
# The .p8 body can keep real newlines or escaped \n; both sign.
CLARITI_APPLE_TEAM_ID=
CLARITI_APPLE_KEY_ID=
CLARITI_APPLE_PRIVATE_KEY=
# Only when Supabase's Apple provider uses a Services ID other than the default
# app.useclariti.web. Apple matches client_id against the client the token was
# issued to, so this is a Services ID, never the iOS bundle id.
CLARITI_APPLE_SERVICES_ID=

CLARITI_ERROR_WEBHOOK_URL=
